extends layout

block content
  .page-header
    h1 Interviews
    if pendingHrCount > 0
      a.btn-sm(href="/admin/hr-requests" style="margin-left:auto;background:var(--warning);color:#000")
        | 📋 HR Requests (#{pendingHrCount})

  .card
    h2 Create Interview
    form(action="/admin/interviews" method="POST")
      .input-row
        div
          label Interview Title
          input(type="text" name="title" placeholder="Frontend Developer" required style="margin-bottom:0")
        div
          label Required Skills
          input(type="text" name="requiredSkills" placeholder="React, Node.js, PostgreSQL" style="margin-bottom:0")
        div
          label Salary Range
          input(type="text" name="salaryRange" placeholder="6-8 LPA or $60k-$80k" style="margin-bottom:0")
      button.btn(type="submit" style="margin-top:12px") + Create Interview

  if interviews && interviews.length
    .interview-grid
      each i in interviews
        .interview-card
          .interview-card-header
            h3= i.title
            span(class=`badge badge-${i.status === 'active' ? 'done' : 'rejected'}`)= i.status
          .interview-card-body
            .stat
              span.stat-value= i.candidate_count || 0
              span.stat-label Candidates
            .stat
              span.stat-value= i.pass_threshold
              span.stat-label Threshold
            p.date= i.created_at ? new Date(i.created_at).toLocaleDateString() : ''
          .interview-card-footer
            a.btn-sm.btn-invite(href=`/admin/interviews/${i.id}`) Open →
            form(action=`/admin/interviews/${i.id}/delete-interview` method="POST" style="display:inline" onsubmit="return confirm('Delete this interview and ALL its candidates?')")
              button.btn-sm.btn-delete(type="submit") ✕ Delete
  else
    .card
      p(style="color:var(--text-muted);text-align:center;padding:40px 0") No interviews yet. Create one to get started.
