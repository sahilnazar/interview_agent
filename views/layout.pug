  body
    //- ── Full-page submit overlay ──────────────────
    #page-loader(style="display:none;position:fixed;inset:0;z-index:99999;background:rgba(10,10,15,0.85);backdrop-filter:blur(6px);display:none;align-items:center;justify-content:center;flex-direction:column;gap:16px")
      .loader-ring
      p(style="font-family:'DM Mono',monospace;font-size:13px;color:#94a3b8;letter-spacing:.5px") Processing…
    style.
      #page-loader { display: none !important; }
      #page-loader.active { display: flex !important; }
      .loader-ring {
        width: 48px; height: 48px;
        border: 3px solid rgba(255,255,255,0.1);
        border-top-color: #00d4ff;
        border-radius: 50%;
        animation: spin .7s linear infinite;
      }
    aside.sidebar
      .logo Interview Assistant
      nav
        a(href="/admin") Interviews
        a(href="/admin/interviewers") Interviewers
        a(href="/admin/hr-requests") HR Requests
        a(href="/admin/settings") Settings
      form(action="/login/logout" method="POST" style="margin-top:auto")
        button.btn-sm(type="submit" style="background:transparent;color:var(--text-muted);border:1px solid var(--border);width:100%") Logout
    main.content
      block content

    script.
      // ── Page submit loader ──────────────────────────────────
      (function () {
        var loader = document.getElementById('page-loader');

        function showLoader() {
          if (loader) loader.classList.add('active');
        }

        // Intercept all form submits (except logout which is fast)
        document.addEventListener('submit', function (e) {
          var form = e.target;
          // Don't show loader for forms that open confirm dialogs that might be cancelled
          // We use a small delay so cancellation (e.g. confirm=false) hides it again
          if (form.getAttribute('onsubmit')) {
            // Has a confirm — wait a tick to see if it was actually submitted
            setTimeout(function () {
              // If we are still on the page, form was not cancelled by confirm
              showLoader();
            }, 50);
          } else {
            showLoader();
          }
        });

        // Hide loader when browser navigates back (bfcache restore)
        window.addEventListener('pageshow', function (e) {
          if (loader) loader.classList.remove('active');
        });
      })();

      // Global fallback so stale inline handlers like onclick="toggleSummary(this)" never break.
      if (!window.toggleSummary) {
        window.toggleSummary = function(buttonOrId) {
          var rowId = typeof buttonOrId === 'string'
            ? 'summary-' + buttonOrId
            : (buttonOrId && buttonOrId.getAttribute ? buttonOrId.getAttribute('data-target') : null);
          if (!rowId) return false;

          var row = document.getElementById(rowId);
          if (!row) return false;

          var isOpen = row.style.display === 'table-row';
          row.style.display = isOpen ? 'none' : 'table-row';

          var btn = typeof buttonOrId === 'string'
            ? document.querySelector('[data-target="' + rowId + '"]')
            : buttonOrId;
          if (btn) btn.textContent = isOpen ? '▶ Details' : '▼ Details';
          return false;
        };
      }
