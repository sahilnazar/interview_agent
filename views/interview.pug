extends layout

block content
  .page-header
    a.back-link(href="/admin") ← All Interviews
    h1= interview.title

  //- ── Settings Panel ──────────────────────────────────────
  .card
    h2 Interview Settings
    form(action=`/admin/interviews/${interview.id}/settings` method="POST")
      label Required Skills (comma separated)
      textarea(name="requiredSkills" rows="3")= interview.required_skills

      label Salary Range / Expectation
      input(type="text" name="salaryRange" value=interview.salary_range placeholder="6-8 LPA or $60k-$80k")

      label Job Description
      textarea(name="jd" rows="6")= interview.jd

      .input-row
        div
          label Domain Filter (regex)
          input(type="text" name="domainFilter" value=interview.domain_filter)
        div.slider-wrap
          label Pass Threshold
          span.slider-val#thresholdVal= interview.pass_threshold
          input(type="range" name="passThreshold" min="0" max="100" value=interview.pass_threshold id="thresholdSlider")

      button.btn(type="submit") Save Settings

    //- Toast notification (hidden by default)
    #settings-toast(style="display:none;position:fixed;bottom:20px;right:20px;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:16px 24px;font-size:14px;z-index:9999;animation:slideIn .3s ease-out;box-shadow:0 4px 12px rgba(0,0,0,.3)")
      span#toast-message

  //- ── Trigger Screening ───────────────────────────────────
  .card
    h2 Trigger Screening
    form(action=`/admin/interviews/${interview.id}/trigger` method="POST" enctype="multipart/form-data")
      .input-row
        div
          label Candidate Email
          input(type="email" name="email" required placeholder="applicant@example.com")
        div
          label Resume (PDF, DOC, DOCX)
          input(type="file" name="resume" accept=".pdf,.doc,.docx" required style="padding:8px")
      button.btn(type="submit") Run Pipeline

  //- ── Candidates Table ────────────────────────────────────
  .card
    .card-header-row
      h2 Candidates
      - const rejectedUnsent = candidates.filter(c => c.status === 'Rejected' && !c.rejection_sent).length
      if rejectedUnsent > 0
        form(action=`/admin/interviews/${interview.id}/bulk-reject-email` method="POST" style="display:inline" onsubmit=`return confirm('Send rejection emails to ${rejectedUnsent} candidate(s)?')`)
          button.btn.btn-bulk-reject(type="submit") ✉ Send Rejection Emails (#{rejectedUnsent})
      if bulkMail && (bulkMail.pendingSelected || bulkMail.pendingNotSelected)
        form(action=`/admin/interviews/${interview.id}/bulk-outcome-email` method="POST" style="display:inline;margin-left:10px")
          button.btn(type="submit") ✉ Send Outcome Emails (#{bulkMail.pendingSelected + bulkMail.pendingNotSelected})

    div(style="overflow-x:auto")
      table
        thead
          tr
            th Email
            th Status
            th Result
            th Video
            th Assigned
            th Resume Score
            th English Score
            th Skills
            th Salary Exp.
            th Created
            th Actions
        tbody#candidates-body
          each c in candidates
            - let parsed = null
            - try { parsed = c.summary ? JSON.parse(c.summary) : null; } catch (e) { parsed = c.summary ? { summary: c.summary, matching: [], missing: [] } : null; }
            - const hasDetails = !!(parsed || c.video_summary || c.salary_expectation)
            - const videoStatus = c.video_path ? (c.status === 'Done' ? 'Analyzed' : c.status === 'Error' ? 'Analyze Failed' : c.status === 'Rejected' ? 'Mismatch' : 'Submitted') : (c.status === 'VideoReceived' ? 'Processing' : '—')
            - const displayStatus = c.status === 'Done' ? (c.english_score != null ? `Passed ${c.english_score.toFixed(0)}%` : 'Passed') : c.status === 'Rejected' && c.video_summary ? 'Failed Match' : c.status === 'Error' ? 'Analysis Error' : c.status
            tr
              td= c.email
              td
                - const s = c.status === 'Done' ? 'done' : c.status === 'Error' ? 'error' : (c.status || '').toLowerCase().replace(/\s+/g,'')
                span(class=`badge badge-${s}`)= displayStatus
                if c.status === 'Rejected' && c.rejection_sent
                  span.badge-sent(title="Rejection email sent") ✉
                if hasDetails
                  div(style="margin-top:8px")
                    button.summary-toggle(type="button" data-target=`summary-${c.thread_id}`) ▶ Details
              td
                if c.final_result === 'pass'
                  span.badge.badge-success Selected
                else if c.final_result === 'fail'
                  span.badge.badge-danger Not Selected
                else
                  span(style="color:var(--text-muted);font-size:12px") Processing
              td
                if videoStatus === 'Submitted' || videoStatus === 'Processing'
                  span(style="color:var(--warning);font-size:12px") ⏳ #{videoStatus}
                else if videoStatus === 'Analyzed'
                  span(style="color:var(--success);font-size:12px") ✔ Analyzed
                else if videoStatus === 'Mismatch'
                  span(style="color:var(--danger);font-size:12px") ✖ Mismatch
                else if videoStatus === 'Analyze Failed'
                  span(style="color:var(--danger);font-size:12px") ✖ Failed
                else
                  span(style="color:var(--text-muted);font-size:12px") —
              td
                if c.assignment_method === 'auto'
                  span.badge.badge-auto(title=`Auto-assigned with ${c.match_confidence != null ? c.match_confidence.toFixed(0) + '%' : '?'} confidence`) Auto #{c.match_confidence != null ? c.match_confidence.toFixed(0) + '%' : ''}
                else
                  span(style="color:var(--text-muted);font-size:12px") Manual
              td.score= c.resume_score != null ? c.resume_score.toFixed(1) + '%' : '—'
              td.score= c.english_score != null ? c.english_score.toFixed(1) : '—'
              td
                if c.skills && c.skills.length
                  each sk in c.skills
                    span.skill-chip= sk
                else
                  | —
              td= c.salary_expectation || '—'
              td= c.created_at ? new Date(c.created_at).toLocaleString() : ''
              td.actions-cell
                if c.status === 'Error'
                  form(action=`/admin/interviews/${interview.id}/retry-analysis/${c.thread_id}` method="POST" style="display:inline")
                    button.btn-sm(type="submit" style="background:#f59e0b;color:#000") ↻ Retry
                if c.status === 'Rejected'
                  form(action=`/admin/interviews/${interview.id}/reselect/${c.thread_id}` method="POST" style="display:inline")
                    button.btn-sm.btn-invite(type="submit") ↩ Re-select
                if c.status === 'Done' && !c.scheduled
                  form(action=`/admin/interviewers/schedule/${c.thread_id}` method="POST" style="display:inline")
                    button.btn-sm(type="submit" style="background:var(--accent)") 📅 Schedule
                if c.status === 'Screened' || c.status === 'AwaitingVideo' || c.status === 'Done'
                  form(action=`/admin/interviews/${interview.id}/reject/${c.thread_id}` method="POST" style="display:inline")
                    button.btn-sm.btn-reject(type="submit") ✗ Reject
                form(action=`/admin/interviews/${interview.id}/delete/${c.thread_id}` method="POST" style="display:inline" onsubmit="return confirm('Delete this candidate?')")
                  button.btn-sm.btn-delete(type="submit") ✕ Delete
            if parsed || c.video_summary || c.salary_expectation
              tr.summary-row(id=`summary-${c.thread_id}` style="display:none")
                td(colspan="11")
                  .summary-box
                    if c.video_summary
                      h4 Video Analysis
                      p= c.video_summary
                    p(style="margin-top:8px")
                      strong Salary Expectation:
                      |  #{c.salary_expectation || 'Not mentioned'}
                    if c.confidence_score != null
                      p
                        strong Confidence Score:
                        |  #{c.confidence_score.toFixed(1)}
                    if interview.required_skills
                      p
                        strong Required Skills:
                        |  #{interview.required_skills}
                    if interview.salary_range
                      p
                        strong Role Salary Range:
                        |  #{interview.salary_range}
                    if parsed
                      h4(style="margin-top:10px") Resume Summary
                      p= parsed.summary
                      h4 ✓ Matching
                      div
                        each m in (parsed.matching || [])
                          span.match-chip= m
                      h4(style="margin-top:10px") ✗ Missing
                      div
                        each m in (parsed.missing || [])
                          span.miss-chip= m

  //- ── CV Watcher Info ─────────────────────────────────────
  .card
    h2 CV Folder Watcher
    p(style="color:var(--text-muted);font-size:13px")
      | Drop PDF, DOC, or DOCX resumes into #[code cvs/#{interview.id}/] to auto-process them.
      br
      | Or drop into #[code cvs/auto/] to let the agent auto-assign to the best-matching interview.
      br
      | Filename format: #[code email@domain.com.pdf] (or .doc / .docx)

  script.
    const INTERVIEW_ID = !{JSON.stringify(interview.id)};
    const ROLE_REQUIRED_SKILLS = !{JSON.stringify(interview.required_skills || '')};
    const ROLE_SALARY_RANGE = !{JSON.stringify(interview.salary_range || '')};
    const tbody = document.getElementById('candidates-body');

    window.showToast = function(message, duration = 3000) {
      const toast = document.getElementById('settings-toast');
      const msg = document.getElementById('toast-message');
      if (!toast || !msg) return;
      msg.textContent = message;
      toast.style.display = 'block';
      setTimeout(() => {
        toast.style.display = 'none';
      }, duration);
    };

    function badgeClass(status) {
      return 'badge badge-' + (status || '').toLowerCase().replace(/\s+/g, '');
    }

    function esc(s) {
      const d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }

    window.toggleSummary = function toggleSummary(buttonOrId) {
      const rowId = typeof buttonOrId === 'string'
        ? 'summary-' + buttonOrId
        : buttonOrId.getAttribute('data-target');
      const row = document.getElementById(rowId);
      if (!row) return false;

      const isOpen = row.style.display === 'table-row';
      row.style.display = isOpen ? 'none' : 'table-row';

      const btn = typeof buttonOrId === 'string'
        ? document.querySelector(`[data-target="${rowId}"]`)
        : buttonOrId;
      if (btn) btn.textContent = isOpen ? '▶ Details' : '▼ Details';
      return false;
    };

    document.addEventListener('click', (event) => {
      const btn = event.target.closest('.summary-toggle');
      if (!btn) return;
      event.preventDefault();
      window.toggleSummary(btn);
    });

    function renderRow(c) {
      const skills = (c.skills && c.skills.length)
        ? c.skills.map(s => `<span class="skill-chip">${esc(s)}</span>`).join('')
        : '—';
      const score = c.resume_score != null ? Number(c.resume_score).toFixed(1) + '%' : '—';

      let parsed = null;
      try { parsed = c.summary ? JSON.parse(c.summary) : null; } catch {
        parsed = c.summary ? { summary: c.summary, matching: [], missing: [] } : null;
      }

      const hasDetails = Boolean(parsed || c.video_summary || c.salary_expectation);

      // Display status
      const displayStatus = c.status === 'Done'
        ? (c.english_score != null ? `Passed ${Number(c.english_score).toFixed(0)}%` : 'Passed')
        : (c.status === 'Rejected' && c.video_summary) ? 'Failed Match'
        : c.status === 'Error' ? 'Analysis Error' : c.status;
      const badgeCls = c.status === 'Done' ? 'badge badge-done'
        : c.status === 'Error' ? 'badge badge-error'
        : 'badge badge-' + (c.status || '').toLowerCase().replace(/\s+/g, '');

      // Video column
      let videoCell = '<span style="color:var(--text-muted);font-size:12px">—</span>';
      if (c.video_path) {
        if (c.status === 'Done') {
          videoCell = '<span style="color:var(--success);font-size:12px">✔ Analyzed</span>';
        } else if (c.status === 'Rejected') {
          videoCell = '<span style="color:var(--danger);font-size:12px">✖ Mismatch</span>';
        } else if (c.status === 'Error') {
          videoCell = '<span style="color:var(--danger);font-size:12px">✖ Failed</span>';
        } else {
          videoCell = '<span style="color:var(--warning);font-size:12px">⏳ Processing</span>';
        }
      } else if (c.status === 'VideoReceived') {
        videoCell = '<span style="color:var(--warning);font-size:12px">⏳ Processing</span>';
      }

      let actions = '';
      if (c.status === 'Error') {
        actions += `<form action="/admin/interviews/${INTERVIEW_ID}/retry-analysis/${c.thread_id}" method="POST" style="display:inline">
          <button class="btn-sm" type="submit" style="background:#f59e0b;color:#000">↻ Retry</button></form>`;
      }
      if (c.status === 'Rejected') {
        actions += `<form action="/admin/interviews/${INTERVIEW_ID}/reselect/${c.thread_id}" method="POST" style="display:inline">
          <button class="btn-sm btn-invite" type="submit">↩ Re-select</button></form>`;
      }
      if (c.status === 'Done') {
        actions += `<form action="/admin/interviewers/schedule/${c.thread_id}" method="POST" style="display:inline">
          <button class="btn-sm" type="submit" style="background:var(--accent)">📅 Schedule</button></form>`;
      }
      if (['Screened', 'AwaitingVideo', 'Done'].includes(c.status)) {
        actions += `<form action="/admin/interviews/${INTERVIEW_ID}/reject/${c.thread_id}" method="POST" style="display:inline">
          <button class="btn-sm btn-reject" type="submit">✗ Reject</button></form>`;
      }
      actions += `<form action="/admin/interviews/${INTERVIEW_ID}/delete/${c.thread_id}" method="POST" style="display:inline" onsubmit="return confirm('Delete this candidate?')">
        <button class="btn-sm btn-delete" type="submit">✕ Delete</button></form>`;

      const sentBadge = (c.status === 'Rejected' && c.rejection_sent)
        ? '<span class="badge-sent" title="Rejection email sent">✉</span>' : '';

      const assignedBadge = c.assignment_method === 'auto'
        ? `<span class="badge badge-auto" title="Auto-assigned ${c.match_confidence != null ? Number(c.match_confidence).toFixed(0) + '%' : ''}">Auto ${c.match_confidence != null ? Number(c.match_confidence).toFixed(0) + '%' : ''}</span>`
        : '<span style="color:var(--text-muted);font-size:12px">Manual</span>';

      let detailsBtn = '';
      if (hasDetails) {
        detailsBtn = `<div style="margin-top:8px"><button class="summary-toggle" type="button" data-target="summary-${c.thread_id}">▶ Details</button></div>`;
      }

      let summaryRow = '';
      if (hasDetails) {
        const matching = parsed ? (parsed.matching || []).map(m => `<span class="match-chip">${esc(m)}</span>`).join('') : '';
        const missing = parsed ? (parsed.missing || []).map(m => `<span class="miss-chip">${esc(m)}</span>`).join('') : '';
        summaryRow = `<tr class="summary-row" id="summary-${c.thread_id}" style="display:none">
          <td colspan="11"><div class="summary-box">
            ${c.video_summary ? `<h4>Video Analysis</h4><p>${esc(c.video_summary)}</p>` : '<h4>Video Analysis</h4><p>Summary not available yet.</p>'}
            <p><strong>Salary Expectation:</strong> ${esc(c.salary_expectation || 'Not mentioned')}</p>
            ${ROLE_REQUIRED_SKILLS ? `<p><strong>Required Skills:</strong> ${esc(ROLE_REQUIRED_SKILLS)}</p>` : ''}
            ${ROLE_SALARY_RANGE ? `<p><strong>Role Salary Range:</strong> ${esc(ROLE_SALARY_RANGE)}</p>` : ''}
            ${c.confidence_score != null ? `<p><strong>Confidence Score:</strong> ${Number(c.confidence_score).toFixed(1)}</p>` : ''}
            ${parsed ? `<h4 style="margin-top:10px">Resume Summary</h4><p>${esc(parsed.summary || 'No resume summary available.')}</p><h4>✓ Matching</h4><div>${matching || '—'}</div><h4 style="margin-top:10px">✗ Missing</h4><div>${missing || '—'}</div>` : ''}
          </div></td></tr>`;
      }

      return `<tr>
        <td>${esc(c.email)}</td>
        <td><span class="${badgeCls}">${esc(displayStatus)}</span>${sentBadge}${detailsBtn}</td>
        <td>${videoCell}</td>
        <td>${assignedBadge}</td>
        <td class="score">${score}</td>
        <td class="score">${c.english_score != null ? Number(c.english_score).toFixed(1) : '—'}</td>
        <td>${skills}</td>
        <td>${esc(c.salary_expectation || '—')}</td>
        <td>${c.created_at ? new Date(c.created_at).toLocaleString() : ''}</td>
        <td class="actions-cell">${actions}</td>
      </tr>${summaryRow}`;
    }

    async function poll() {
      try {
        const res = await fetch(`/api/interviews/${INTERVIEW_ID}/candidates`);
        if (!res.ok) return;
        const data = await res.json();
        const openSummaries = new Set();
        tbody.querySelectorAll('.summary-row').forEach(row => {
          if (row.style.display !== 'none') openSummaries.add(row.id);
        });
        tbody.innerHTML = data.map(renderRow).join('');
        openSummaries.forEach(id => {
          const row = document.getElementById(id);
          if (row) {
            row.style.display = 'table-row';
            const btn = row.previousElementSibling.querySelector('.summary-toggle');
            if (btn) btn.textContent = '▼ Details';
          }
        });
      } catch { /* ignore */ }
    }

    setInterval(poll, 5000);

    // ── Settings form feedback with toast ────────────
    const settingsForm = document.querySelector('form[action$="/settings"]');
    const settingsToast = document.getElementById('settings-toast');

    if (settingsForm) {
      settingsForm.addEventListener('submit', async function(e) {
        if (settingsToast) {
          window.showToast('⏳ Saving...');
          setTimeout(() => {
            window.showToast('✔ Settings saved', 3000);
          }, 500);
        }
      });
    }

    const slider = document.getElementById('thresholdSlider');
    const valEl  = document.getElementById('thresholdVal');
    if (slider && valEl) {
      slider.addEventListener('input', () => { valEl.textContent = slider.value; });
    }
